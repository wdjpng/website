# HTTPS certificate validation and canonical redirect for the www alias.
server {
    listen 80;
    listen [::]:80;
    server_name www.lukasmuenzel.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://munzel.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.lukasmuenzel.com;
    ssl_certificate /etc/letsencrypt/live/www.lukasmuenzel.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.lukasmuenzel.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    return 301 https://munzel.com$request_uri;
}
